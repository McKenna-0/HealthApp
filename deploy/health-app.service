[Unit]
Description=Personal health app (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/health-app/backend
# Bind to localhost only - `tailscale serve` fronts it with HTTPS
ExecStart=/home/pi/.local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
