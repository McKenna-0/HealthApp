# Copy to .env and fill in. .env is gitignored.

# "mock" (default, no Garmin needed) or "garmin"
DATA_SOURCE=mock

# IANA timezone used for "today" everywhere
TZ=Europe/Dublin

# Garmin Connect credentials (only needed when DATA_SOURCE=garmin).
# Password is used once to obtain OAuth tokens, which are cached in
# backend/.garmin_tokens/ and auto-refreshed after that.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Free API key from https://fdc.nal.usda.gov/api-key-signup.html
# (optional - Open Food Facts works without any key)
USDA_API_KEY=

# AI analyst (optional). Any OpenAI-compatible endpoint works.
# Default: OpenRouter (https://openrouter.ai/keys). Prefer paid open models
# with no-logging policies over ":free" variants for privacy.
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.3-70b-instruct

# GitHub issue poller (optional — for auto-implementing issues via Claude CLI)
# GITHUB_REPO=McKenna-0/HealthApp
# POLL_INTERVAL_MINUTES=5
